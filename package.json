{
  "name": "kcadm-node",
  "version": "0.1.0",
  "description": "Keycloak administration CLI for Node.js with kcadm-style commands",
  "scripts": {
    "test": "npm run build && node --test test/cli.test.js",
    "build": "tsc",
    "test:matrix": "npm run build && python3 test/integration/run.py",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thundax-lyp/kcadm-node.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/thundax-lyp/kcadm-node/issues"
  },
  "homepage": "https://github.com/thundax-lyp/kcadm-node#readme",
  "type": "module",
  "bin": {
    "kcadm-node": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@keycloak/keycloak-admin-client": "26.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
